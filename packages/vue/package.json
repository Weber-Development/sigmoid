{
  "name": "@sweberdev/sigmoid-vue",
  "version": "0.5.0",
  "description": "Vue 3 directives and composables for Sigmoid: v-reveal, v-parallax, useScrollProgress and useStory on native CSS scroll timelines.",
  "license": "MIT",
  "author": "Seya Weber (https://github.com/sxwxbxr)",
  "homepage": "https://packages.sweber.dev/sigmoid/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Weber-Development/sigmoid.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/Weber-Development/sigmoid/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "vue",
    "vue3",
    "animation",
    "scroll",
    "scroll-driven-animations",
    "parallax",
    "reveal",
    "spring",
    "reduced-motion"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@sweberdev/sigmoid": "workspace:^"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jsdom": "^27.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3",
    "vue": "^3.5.0"
  }
}
