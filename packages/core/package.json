{
  "name": "@sweberdev/sigmoid",
  "version": "0.5.0",
  "description": "Scroll motion without the JavaScript tax: native CSS scroll-driven animations, spring and S-curve easings as CSS linear(), a tiny fallback, reduced motion by default.",
  "license": "MIT",
  "author": "Seya Weber (https://github.com/sxwxbxr)",
  "homepage": "https://packages.sweber.dev/sigmoid/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Weber-Development/sigmoid.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Weber-Development/sigmoid/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./easing": {
      "import": {
        "types": "./dist/easing.d.ts",
        "default": "./dist/easing.js"
      },
      "require": {
        "types": "./dist/easing.d.cts",
        "default": "./dist/easing.cjs"
      }
    },
    "./sigmoid.css": "./dist/sigmoid.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "animation",
    "scroll",
    "scroll-driven-animations",
    "scroll-timeline",
    "view-timeline",
    "easing",
    "spring",
    "linear-easing",
    "parallax",
    "reveal",
    "reduced-motion",
    "tailwindcss"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && node scripts/build-css.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "size": "node scripts/size.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.27.7",
    "jsdom": "^27.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
